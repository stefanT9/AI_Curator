# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# `.env*` already covers `.env.test.local`, the integration lane's locally
# generated stack credentials — see the Tests section of AGENTS.md.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Live smoke-check output (test/smoke), regenerated on each run.
test/smoke/.last-result.json

# Seed corpus images — fetched from the Art Institute of Chicago by
# `npm run db:seed:fetch`, ~40 MB. The durable artifact is the manifest,
# `supabase/seed-assets/corpus.json`, which is tracked.
/supabase/seed-assets/00000000-0000-4000-8000-000000000001/
