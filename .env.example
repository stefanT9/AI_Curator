# Supabase project settings → Data API
# Both are browser-safe. Never put a service_role / secret key in a
# NEXT_PUBLIC_ variable — those are shipped to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OpenRouter — AI enrichment for artwork uploads (description + tag suggestions).
# Server-only: deliberately NOT NEXT_PUBLIC_, so it never reaches the browser.
# Optional. With it unset, enrichment is disabled and upload/publish still work.
# Free tier: 20 requests/minute, and 1000/day once $10 of credits is purchased.
OPENROUTER_API_KEY=sk-or-v1-...
