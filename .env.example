# Supabase project settings → Data API
# Both are browser-safe. Never put a service_role / secret key in a
# NEXT_PUBLIC_ variable — those are shipped to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OpenRouter — AI enrichment for artwork uploads (description + tag suggestions).
# Server-only: deliberately NOT NEXT_PUBLIC_, so it never reaches the browser.
# Optional. With it unset, enrichment is disabled and upload/publish still work.
# Free tier: 20 requests/minute, and 1000/day once $10 of credits is purchased.
OPENROUTER_API_KEY=sk-or-v1-...

# Resend — outbound email (auction outcomes, liker notifications).
# Server-only: deliberately NOT NEXT_PUBLIC_, so it never reaches the browser.
# Optional. With it unset, `sendEmail` returns `unconfigured` and nothing else
# breaks — no caller in the app depends on it yet.
# Free tier: 3,000/month, 100/day, 10 requests/second.
RESEND_API_KEY=re_...

# Optional sender identity. Defaults to Resend's shared domain,
# "ArtSwipe <onboarding@resend.dev>", which needs no DNS and no domain
# verification — but delivers ONLY to the Resend account owner's own address.
# Every other recipient comes back 403 (`not_permitted`). Set this to an
# address on a verified domain to send to anyone else; that is a config change,
# not a code change.
EMAIL_FROM=ArtSwipe <onboarding@resend.dev>

# The live smoke check's recipient (`npm run test:smoke -- email`). With the
# default sender this must be the Resend account owner's own address.
SMOKE_EMAIL_TO=you@example.com

# Corpus push (`npm run db:push`) — writes supabase/seed-assets/corpus.json to
# a target project as a dedicated demo artist. These go in .env.push.local,
# never .env.local: they are deliberately distinct from NEXT_PUBLIC_* so a
# .env.local swapped between the local and remote pairs cannot redirect a
# push. No service-role / secret key belongs here, or anywhere in this repo.
# See supabase/seed-assets/README.md.
PUSH_SUPABASE_URL=https://your-project-ref.supabase.co
PUSH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
PUSH_ARTIST_EMAIL=demo-artist@example.com
PUSH_ARTIST_PASSWORD=...