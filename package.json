{
  "name": "artswipe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.smoke.config.mts",
    "test:integration": "node --env-file-if-exists=.env.test.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:reset": "supabase db reset && npm run db:seed:images",
    "db:seed:images": "supabase storage cp --experimental --local -r supabase/seed-assets/00000000-0000-4000-8000-000000000001 ss:///artworks/00000000-0000-4000-8000-000000000001",
    "db:seed:fetch": "tsx --conditions=react-server scripts/build-corpus.ts fetch",
    "db:seed:enrich": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/build-corpus.ts enrich",
    "db:seed:enrich:resume": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/build-corpus.ts enrich",
    "db:seed:enrich:retry": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/build-corpus.ts enrich --retry-failed",
    "db:seed:coverage": "tsx --conditions=react-server scripts/build-corpus.ts coverage",
    "db:seed:generate": "tsx --conditions=react-server scripts/build-corpus.ts generate",
    "db:push": "tsx --conditions=react-server --env-file-if-exists=.env.push.local scripts/build-corpus.ts push",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts.tmp && mv src/types/database.ts.tmp src/types/database.ts",
    "db:types:local": "supabase gen types typescript --local > src/types/database.ts.tmp && mv src/types/database.ts.tmp src/types/database.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.96",
    "client-only": "^0.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
